{
  "name": "@bsnbase/utils",
  "version": "1.2.5",
  "description": "",
  "type": "module",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "typings": "dist/types/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/types/src/index.d.ts"
    }
  },
  "scripts": {
    "push": "npm publish --registry http://npm.bsnbase.top/ && npm publish --access public --registry https://registry.npmjs.org",
    "test": "jest",
    "dev": "rollup -c -w",
    "build:esm": "BUILD_FORMAT=esm rollup -c && mv dist/esm/types dist",
    "build:cjs": "BUILD_FORMAT=cjs rollup -c && mv dist/cjs/types dist",
    "packages": "rm -rf packages && mkdir packages",
    "build:prod": "npm run build:esm && npm run build:cjs && npm run packages && mv dist packages && cp -f package.json packages && cp -f README.md packages",
    "lint:es": "eslint src --fix --ext .tsx --ext .ts",
    "tslint": "tsc --noEmit"
  },
  "jest": {
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "testRegex": "(/__tests__/.*|(\\.|/)(test|spec))\\.tsx?$",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ]
  },
  "engines": {
    "node": ">18.0.0",
    "pnpm": ">8.0.0 <9.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@babel/cli": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^25.0.8",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.20",
    "@types/node": "^20.19.7",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "babel-plugin-lodash": "^3.3.4",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-prettier": "^5.5.1",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "rollup": "^3.29.5",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@rollup/plugin-replace": "^6.0.1",
    "dayjs": "^1.11.18",
    "dotenv": "^17.2.3",
    "glob": "^10.4.5",
    "lodash": "^4.17.21"
  }
}
